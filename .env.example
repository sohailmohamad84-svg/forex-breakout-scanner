# ==============================================================================
# Forex Breakout Probability Scanner - Environment Configuration Template
# ==============================================================================

# Application
PROJECT_NAME="Forex Breakout Probability Scanner"
VERSION="1.0.0"

# Database Configuration
# SQLite (Default for zero-setup local execution):
DATABASE_URL="sqlite:///./forex_scanner.db"
# PostgreSQL (Production deployment, e.g. Render / AWS RDS / Supabase):
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/forex_scanner"

# Market Data Provider
# Options: yahoo | twelve_data | oanda | mock
DEFAULT_PROVIDER="yahoo"

# Strategy & Scanner Defaults
DEFAULT_THRESHOLD=70.0
DEFAULT_LOOKBACK=200
DEFAULT_PERCENTAGE_STEP=0.002
SCAN_INTERVAL_SECONDS=60
MAX_CONCURRENCY=4
MAX_SIGNAL_AGE_MINUTES=180

# Twelve Data API (Optional - Required only if provider is set to 'twelve_data')
# Get a free key at: https://twelvedata.com/
TWELVE_DATA_API_KEY=""

# OANDA v20 API (Optional - Required only if provider is set to 'oanda')
# Get credentials at: https://www.oanda.com/
OANDA_API_KEY=""
OANDA_ACCOUNT_ID=""
OANDA_IS_LIVE=false

# Telegram Notifications (Optional - Leave empty to disable)
# 1. Create a bot with @BotFather on Telegram and copy the Bot Token.
# 2. Get your numeric chat ID from @userinfobot or channel ID (@yourchannel).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:8000"
